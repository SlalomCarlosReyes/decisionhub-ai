{
  "name": "decisionhub-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-driven AI agent platform for decision support (MVP)",
  "author": "Carlos Reyes",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" --names \"API,WEB\" --prefix-colors \"blue,magenta\"",
    "dev:api": "npm run dev --workspace=@decisionhub/api",
    "dev:web": "npm run dev --workspace=@decisionhub/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@decisionhub/api",
    "build:web": "npm run build --workspace=@decisionhub/web",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
