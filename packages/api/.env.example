# API Configuration
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Provider Configuration
# Options: 'github', 'mock'
AI_PROVIDER=mock

# GitHub Models API Configuration
# To use Claude Sonnet 4.5 or other models via GitHub Models:
# 1. Get a GitHub Personal Access Token from https://github.com/settings/tokens
# 2. Enable 'model' scope for the token
# 3. Set GITHUB_TOKEN below
# 4. Choose a model ID (see available models at https://github.com/marketplace/models)
#
# Example model IDs:
# - gpt-4o (OpenAI GPT-4 Optimized)
# - gpt-4o-mini (OpenAI GPT-4 Mini)
# - claude-sonnet-4 (if available)
# - o1-preview (OpenAI O1 Preview)
# - o1-mini (OpenAI O1 Mini)
#
# IMPORTANT: Only use model IDs that actually exist and are available in GitHub Models.
# Check https://github.com/marketplace/models for the current list.

GITHUB_TOKEN=
MODEL_ID=gpt-4o

# Future: Add API keys for additional providers
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# ===================================
# Real-Time Data Collection (Phase 2)
# ===================================

# Enable/disable real-time data fetching
ENABLE_REAL_TIME_DATA=false

# Timeout for real-time data operations (milliseconds)
REAL_TIME_TIMEOUT=10000

# Cache TTL settings (seconds)
CACHE_TTL_REVIEWS=86400  # 24 hours
CACHE_TTL_PRICING=7200   # 2 hours
CACHE_TTL_SAFETY=86400   # 24 hours

# External API Keys
# Mercado Libre API (for Colombian market prices)
# Register at: https://developers.mercadolibre.com/
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_SECRET_KEY=

# Edmunds API (optional, for US market reviews)
# Register at: https://developer.edmunds.com/
EDMUNDS_API_KEY=

# Consumer Reports API (optional, if available)
CONSUMER_REPORTS_API_KEY=

# Rate Limiting Configuration
# Requests per minute per source
RATE_LIMIT_TUCARRO=10
RATE_LIMIT_OLX=10
RATE_LIMIT_MERCADOLIBRE=20
RATE_LIMIT_CONSUMER_REPORTS=6
RATE_LIMIT_NHTSA=60

